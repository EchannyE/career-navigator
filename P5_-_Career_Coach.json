      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Extract the job title, company name, and full cleaned job description from the raw HTML content below.\n\nReturn ONLY this format:\n\nJOB TITLE: [title]\n\nCOMPANY NAME: [company]\n\nJOB DESCRIPTION:\n[full cleaned description]\n\nIf the page is empty, blocked, or unrelated to a job listing, return ONLY:\n\nPAGE_ERROR: The job page could not be retrieved. Please paste the job description directly into the chat.\n\nRAW HTML CONTENT:\n{{ $json.data }}",
        "messages": {
          "messageValues": [
            {
              "message": "=You are a precise web content extractor.\n\nYour job is to clean raw HTML from a job listing page and extract only relevant job information.\n\nRemove:\n- HTML tags\n- navigation text\n- cookie notices\n- footer text\n- advertisements\n- unrelated content\n\nReturn only structured job information with no explanations and no extra commentary."
            }
          ]
        }
      },
      "id": "57889f63-1283-4153-a09d-5ccecb8a4098",
      "name": "Chain 1 - Job Content Extractor",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        128,
        16
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash-lite",
        "options": {
          "maxOutputTokens": 1024,
          "temperature": 0.2
        }
      },
      "id": "46ec2ce5-1913-43df-b03a-605c7fb66664",
      "name": "Gemini - Job Extractor",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        160,
        256
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "5BpItqFxZTLBh7LS",
          "name": "Google Gemini(PaLM) Api account 5"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze the candidate resume against the extracted job description.\n\nUse evidence-based reasoning:\n- Compare actual demonstrated skills, not just keyword matches\n- Do not invent experience that is not in the resume\n- Do not ignore important job requirements\n- Consider transferable skills where relevant\n- Be honest, specific, and practical\n\nReturn your response in EXACTLY this format:\n\nMATCH SCORE: [A number from 0 to 100]%\n\nMATCHED SKILLS:\n- [List every skill, qualification, or experience the candidate has that matches the job requirements]\n\nSKILL GAPS:\n- [List every required or preferred skill, tool, or qualification mentioned in the job that the candidate does not have]\n\nEXPERIENCE GAPS:\n- [Note any experience level, industry background, domain knowledge, or leadership responsibility gaps]\n\nMISSING KEYWORDS:\n- [List specific technical keywords, tools, certifications, or role-specific phrases from the job description that do not appear in the resume]\n\nOVERALL ASSESSMENT:\n[2\u20133 sentences summarising the candidate's fit for this role. Clearly state whether this is a strong match, moderate match, stretch match, or weak match.]\n\n---\n\nCANDIDATE RESUME:\n{{ $('Set Resume Data').first().json.resume }}\n\nJOB DESCRIPTION:\n{{ $json.text }}",
        "messages": {
          "messageValues": [
            {
              "message": "=You are an expert Career Coach and Technical Recruiter with 15 years of experience in talent acquisition and professional development.\n\nBe honest, specific, practical, and constructive.\n\nDo not invent skills that are not present in the resume.\nDo not ignore important requirements from the job description.\nUse the exact section headings requested by the user."
            }
          ]
        }
      },
      "id": "03713d06-a75e-46ef-8cf5-47da85d76707",
      "name": "Chain 2 - Gap Analyzer",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        448,
        16
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash-lite",
        "options": {
          "maxOutputTokens": 1500,
          "temperature": 0.4
        }
      },
      "id": "62241192-5bf2-4a8d-9d57-0b5b400a5bd4",
      "name": "Gemini - Gap Analyzer",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        464,
        208
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "5BpItqFxZTLBh7LS",
          "name": "Google Gemini(PaLM) Api account 5"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Create a clear, actionable, and encouraging learning plan based on the gap analysis below.\n\nReturn your response in EXACTLY this format:\n\nACTION PLAN - PRIORITY SKILLS TO LEARN:\n\nHIGH PRIORITY (Learn these first - they appear most in the job description):\n1. [Skill name]\n   - Why it matters: [1 sentence]\n   - How to learn it: [Specific free resource - course name, YouTube channel, or documentation link]\n   - Estimated time: [e.g., 2 weeks, 1 month]\n\n2. [Repeat for each high-priority skill]\n\nMEDIUM PRIORITY (Important but not blocking):\n1. [Skill name]\n   - Why it matters: [1 sentence]\n   - How to learn it: [Specific resource]\n   - Estimated time: [timeframe]\n\nQUICK WINS (Add to your resume this week):\n- [Things the candidate likely already knows or can add quickly - portfolio projects, certifications, wording improvements]\n\nRESUME IMPROVEMENT TIPS:\n- [2-3 specific tips to make the resume stronger for this exact role]\n\nENCOURAGEMENT:\n[1-2 sentences of genuine, specific encouragement based on what the candidate already has]\n\n---\n\nGAP ANALYSIS INPUT:\n{{ $json.text }}",
        "messages": {
          "messageValues": [
            {
              "message": "=You are an expert Career Coach.\n\nYour job is to turn a resume/job gap analysis into a practical learning roadmap.\n\nPrioritize the most important missing skills first.\nRecommend specific free resources where possible.\nKeep the tone encouraging but realistic.\nUse the exact section headings requested by the user."
            }
          ]
        }
      },
      "id": "0faaaedb-8191-487c-b513-49d82812e57f",
      "name": "Chain 3 - Action Plan Generator",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        768,
        16
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash-lite",
        "options": {
          "maxOutputTokens": 2000,
          "temperature": 0.7
        }
      },
      "id": "b30e284a-1d94-4962-86b5-9131a69ec711",
      "name": "Gemini - Action Plan",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        800,
        240
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "5BpItqFxZTLBh7LS",
          "name": "Google Gemini(PaLM) Api account 5"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const resumeData = $('Set Resume Data').first().json || {};\n\nconst resumeInput = resumeData.resume || '';\nconst jobUrl = resumeData.jobUrl || '';\n\nconst jobExtraction = $('Chain 1 - Job Content Extractor').first().json.text || '';\nconst gapAnalysis = $('Chain 2 - Gap Analyzer').first().json.text || '';\nconst actionPlan = $('Chain 3 - Action Plan Generator').first().json.text || '';\n\n// Extract job title and company from Chain 1 output\nconst jobTitleMatch = jobExtraction.match(/JOB TITLE:\\s*(.+)/i);\nconst companyMatch = jobExtraction.match(/COMPANY NAME:\\s*(.+)/i);\n\nconst jobTitle = jobTitleMatch\n  ? jobTitleMatch[1].trim()\n  : 'Unknown Role';\n\nconst company = companyMatch\n  ? companyMatch[1].trim()\n  : 'Unknown Company';\n\n// Extract numeric match score from Chain 2 output\nconst scoreMatch = gapAnalysis.match(/MATCH SCORE:\\s*(\\d+)/i);\n\nconst matchScore = scoreMatch\n  ? parseInt(scoreMatch[1])\n  : 0;\n\nreturn [\n  {\n    json: {\n      metadata: {\n        generatedAt: new Date().toISOString(),\n        jobTitle,\n        company,\n        jobUrl,\n        matchScore: `${matchScore}%`\n      },\n\n      resumeInput,\n      gapAnalysis,\n      actionPlan,\n\n      fullReport:\n        `CAREER COACH NAVIGATOR REPORT\\n\\n` +\n        `Role: ${jobTitle} at ${company}\\n` +\n        `Match Score: ${matchScore}%\\n` +\n        `Generated: ${new Date().toLocaleString()}\\n\\n` +\n        `GAP ANALYSIS\\n\\n${gapAnalysis}\\n\\n` +\n        `ACTION PLAN\\n\\n${actionPlan}`\n    }\n  }\n];"
      },
